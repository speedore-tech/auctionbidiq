# auctionbidiq — production env for docker-compose.prod.yml
# Copy to .env on the VPS and fill in. This file is read by `docker compose`.

# Public domain (Traefik routes this to the app container, auto-SSL)
DOMAIN=auctionbidiq.srv1334765.hstgr.cloud

# Postgres password (used by both the db and app containers).
# Use letters/digits only — it is embedded in the database URL.
DB_PASSWORD=change-me-strong-db-password

# Keep public sign-up OFF in production; create logins with scripts/create_admin.py
BIDIQ_ALLOW_REGISTRATION=false
BIDIQ_TOKEN_TTL_DAYS=30

# First admin login (read by: ... exec auctionbidiq-app python scripts/create_admin.py)
SEED_ADMIN_EMAIL=admin@speedore.com
SEED_ADMIN_PASSWORD=change-me-admin-password
SEED_TENANT_NAME=Speedore / Sohi Transportation
